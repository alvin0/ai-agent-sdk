{
  "name": "@ai-agent-sdk/a2a",
  "version": "0.1.0",
  "private": true,
  "description": "Node-elevated official A2A client/server bridge for ai-agent-sdk",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "files": ["dist", "README.md", "LICENSE"],
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": { "types": "./dist/index.d.mts", "default": "./dist/index.mjs" },
    "./client": { "types": "./dist/client.d.mts", "default": "./dist/client.mjs" },
    "./server": { "types": "./dist/server.d.mts", "default": "./dist/server.mjs" },
    "./package.json": "./package.json"
  },
  "publishConfig": { "access": "public", "provenance": true },
  "scripts": {
    "build": "tsdown",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true});require('node:fs').rmSync('artifacts',{recursive:true,force:true})\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "pack": "pnpm pack --pack-destination artifacts",
    "test:pack": "node scripts/test-packed.mts",
    "check:publint": "publint",
    "check:types": "attw --profile esm-only --pack ."
  },
  "dependencies": {
    "@a2a-js/sdk": "catalog:",
    "@ai-agent-sdk/agent": "workspace:^",
    "@ai-agent-sdk/core": "workspace:^"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@types/node": "catalog:",
    "publint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  },
  "aiAgentSdk": { "runtime": "node" }
}
