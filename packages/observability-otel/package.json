{
  "name": "@alvin0/ai-agent-sdk-observability-otel",
  "author": {
    "name": "alvin0 - chaulamdinhai",
    "email": "chaulamdinhai@gmail.com"
  },
  "version": "0.1.1",
  "description": "Universal OpenTelemetry API bridge for correlated ai-agent-sdk spans, metrics, and logs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alvin0/ai-agent-sdk.git",
    "directory": "packages/observability-otel"
  },
  "homepage": "https://github.com/alvin0/ai-agent-sdk/tree/main/packages/observability-otel#readme",
  "bugs": { "url": "https://github.com/alvin0/ai-agent-sdk/issues" },
  "type": "module",
  "sideEffects": false,
  "files": ["dist", "README.md", "LICENSE"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js", "default": "./dist/index.js" },
    "./package.json": "./package.json"
  },
  "publishConfig": { "access": "public", "provenance": true },
  "scripts": {
    "build": "tsdown",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true});require('node:fs').rmSync('artifacts',{recursive:true,force:true})\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "pack": "pnpm pack --pack-destination artifacts",
    "test:pack": "node scripts/test-packed.mts",
    "check:publint": "publint",
    "check:types": "attw --profile esm-only --pack ."
  },
  "peerDependencies": {
    "@alvin0/ai-agent-sdk-core": "workspace:^",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.221.0"
  },
  "peerDependenciesMeta": {
    "@opentelemetry/api-logs": { "optional": true }
  },
  "devDependencies": {
    "@alvin0/ai-agent-sdk-core": "workspace:^",
    "@arethetypeswrong/cli": "catalog:",
    "@opentelemetry/api": "catalog:",
    "@opentelemetry/api-logs": "catalog:",
    "playwright": "catalog:",
    "publint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  },
  "aiAgentSdk": {
    "runtime": "universal",
    "coreApi": 1,
    "roles": ["observation-processor"]
  }
}
