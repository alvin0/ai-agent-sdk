{
  "name": "@alvin0/ai-agent-sdk-mcp-node-server",
  "author": {
    "name": "alvin0 - chaulamdinhai",
    "email": "chaulamdinhai@gmail.com"
  },
  "version": "0.1.1",
  "description": "Node stdio and HTTP MCP server hosting for ai-agent-sdk",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alvin0/ai-agent-sdk.git",
    "directory": "packages/mcp-node-server"
  },
  "homepage": "https://github.com/alvin0/ai-agent-sdk/tree/main/packages/mcp-node-server#readme",
  "bugs": { "url": "https://github.com/alvin0/ai-agent-sdk/issues" },
  "type": "module",
  "sideEffects": false,
  "files": ["dist", "README.md", "LICENSE"],
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": { "types": "./dist/index.d.mts", "import": "./dist/index.mjs", "default": "./dist/index.mjs" },
    "./package.json": "./package.json"
  },
  "publishConfig": { "access": "public", "provenance": true },
  "scripts": {
    "build": "tsdown",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true});require('node:fs').rmSync('artifacts',{recursive:true,force:true})\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "pack": "pnpm pack --pack-destination artifacts",
    "test:pack": "node ../../scripts/test-packed-node-capability.mts mcp-node-server",
    "check:publint": "publint",
    "check:types": "attw --profile esm-only --pack ."
  },
  "dependencies": {
    "@alvin0/ai-agent-sdk-mcp-server": "workspace:^",
    "@modelcontextprotocol/node": "catalog:",
    "@modelcontextprotocol/server": "catalog:"
  },
  "peerDependencies": {
    "@alvin0/ai-agent-sdk-core": "workspace:^"
  },
  "devDependencies": {
    "@alvin0/ai-agent-sdk-core": "workspace:^",
    "@arethetypeswrong/cli": "catalog:",
    "@types/node": "catalog:",
    "publint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": { "node": ">=22.12" },
  "aiAgentSdk": {
    "runtime": "node",
    "coreApi": 1,
    "roles": ["mcp-server-transport"]
  }
}
