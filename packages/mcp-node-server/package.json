{
  "name": "@ai-agent-sdk/mcp-node-server",
  "version": "0.1.0",
  "private": true,
  "description": "Node stdio and HTTP MCP server hosting for ai-agent-sdk",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "files": ["dist", "README.md", "LICENSE"],
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": { "types": "./dist/index.d.mts", "import": "./dist/index.mjs", "default": "./dist/index.mjs" },
    "./package.json": "./package.json"
  },
  "publishConfig": { "access": "public", "provenance": true },
  "scripts": {
    "build": "tsdown",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true});require('node:fs').rmSync('artifacts',{recursive:true,force:true})\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "pack": "pnpm pack --pack-destination artifacts",
    "test:pack": "node ../../scripts/test-packed-node-capability.mts mcp-node-server",
    "check:publint": "publint",
    "check:types": "attw --profile esm-only --pack ."
  },
  "dependencies": {
    "@ai-agent-sdk/mcp-server": "workspace:^",
    "@modelcontextprotocol/node": "catalog:",
    "@modelcontextprotocol/server": "catalog:"
  },
  "peerDependencies": {
    "@ai-agent-sdk/core": "workspace:^"
  },
  "devDependencies": {
    "@ai-agent-sdk/core": "workspace:^",
    "@arethetypeswrong/cli": "catalog:",
    "@types/node": "catalog:",
    "publint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": { "node": ">=22.12" },
  "aiAgentSdk": {
    "runtime": "node",
    "coreApi": 1,
    "roles": ["mcp-server-transport"]
  }
}
