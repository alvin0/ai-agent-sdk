{
  "name": "ai-agent-sdk",
  "version": "0.1.0",
  "private": true,
  "description": "Compatibility facade for the modular ai-agent-sdk packages",
  "keywords": ["ai", "agent", "llm", "anthropic", "openai", "sdk", "typescript"],
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "files": ["dist", "README.md", "LICENSE"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./anthropic": { "types": "./dist/anthropic.d.ts", "default": "./dist/anthropic.js" },
    "./openai": { "types": "./dist/openai.d.ts", "default": "./dist/openai.js" },
    "./codex": { "types": "./dist/codex.d.ts", "default": "./dist/codex.js" },
    "./a2a-client": { "types": "./dist/a2a-client.d.ts", "default": "./dist/a2a-client.js" },
    "./a2a-server": { "types": "./dist/a2a-server.d.ts", "default": "./dist/a2a-server.js" },
    "./skill-filesystem": { "types": "./dist/skill-filesystem.d.ts", "default": "./dist/skill-filesystem.js" },
    "./request-logger": { "types": "./dist/request-logger.d.ts", "default": "./dist/request-logger.js" },
    "./mcp-client": { "types": "./dist/mcp-client.d.ts", "default": "./dist/mcp-client.js" },
    "./mcp-server": { "types": "./dist/mcp-server.d.ts", "default": "./dist/mcp-server.js" },
    "./mcp-node": { "types": "./dist/mcp-node.d.ts", "default": "./dist/mcp-node.js" },
    "./node": { "types": "./dist/node.d.ts", "default": "./dist/node.js" },
    "./package.json": "./package.json"
  },
  "publishConfig": { "access": "public", "provenance": true },
  "scripts": {
    "build": "tsdown",
    "clean": "node -e \"for(const p of ['dist','artifacts'])require('node:fs').rmSync(p,{recursive:true,force:true})\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "pack": "pnpm pack --pack-destination artifacts",
    "test:pack": "node scripts/test-packed.mts",
    "check:publint": "publint",
    "check:types": "attw --profile esm-only --pack ."
  },
  "dependencies": {
    "@ai-agent-sdk/agent": "workspace:^",
    "@ai-agent-sdk/core": "workspace:^",
    "@ai-agent-sdk/provider-http": "workspace:^",
    "@ai-agent-sdk/protocol-anthropic-messages": "workspace:^",
    "@ai-agent-sdk/protocol-responses": "workspace:^"
  },
  "peerDependencies": {
    "@ai-agent-sdk/a2a": "workspace:^",
    "@ai-agent-sdk/auth-node": "workspace:^",
    "@ai-agent-sdk/mcp": "workspace:^",
    "@ai-agent-sdk/mcp-node": "workspace:^",
    "@ai-agent-sdk/node": "workspace:^",
    "@ai-agent-sdk/observability-node": "workspace:^",
    "@ai-agent-sdk/provider-anthropic": "workspace:^",
    "@ai-agent-sdk/provider-openai": "workspace:^",
    "@ai-agent-sdk/skill-filesystem": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@ai-agent-sdk/a2a": { "optional": true },
    "@ai-agent-sdk/auth-node": { "optional": true },
    "@ai-agent-sdk/mcp": { "optional": true },
    "@ai-agent-sdk/mcp-node": { "optional": true },
    "@ai-agent-sdk/node": { "optional": true },
    "@ai-agent-sdk/observability-node": { "optional": true },
    "@ai-agent-sdk/provider-anthropic": { "optional": true },
    "@ai-agent-sdk/provider-openai": { "optional": true },
    "@ai-agent-sdk/skill-filesystem": { "optional": true }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@types/node": "catalog:",
    "publint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "aiAgentSdk": { "runtime": "mixed" }
}
