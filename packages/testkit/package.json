{
  "name": "@ai-agent-sdk/testkit",
  "version": "0.1.0",
  "private": true,
  "description": "Framework-independent conformance suites for ai-agent-sdk capability authors",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "files": ["dist", "README.md"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true});require('node:fs').rmSync('artifacts',{recursive:true,force:true})\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "pack": "pnpm pack --pack-destination artifacts",
    "test:pack": "node scripts/test-packed.mts",
    "check:publint": "publint",
    "check:types": "attw --profile esm-only --pack ."
  },
  "peerDependencies": {
    "@ai-agent-sdk/core": "workspace:^"
  },
  "devDependencies": {
    "@ai-agent-sdk/core": "workspace:^",
    "@arethetypeswrong/cli": "catalog:",
    "publint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "aiAgentSdk": {
    "runtime": "universal",
    "coreApi": 1,
    "roles": ["development-testkit"]
  }
}
