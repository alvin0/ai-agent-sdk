{
  "name": "@ai-agent-sdk/node",
  "version": "0.1.0",
  "private": true,
  "description": "Batteries-included Node facade for ai-agent-sdk",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "files": ["dist", "README.md", "LICENSE"],
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": { "types": "./dist/index.d.mts", "default": "./dist/index.mjs" },
    "./core": { "types": "./dist/core.d.mts", "default": "./dist/core.mjs" },
    "./agent": { "types": "./dist/agent.d.mts", "default": "./dist/agent.mjs" },
    "./providers": { "types": "./dist/providers.d.mts", "default": "./dist/providers.mjs" },
    "./observability": { "types": "./dist/observability.d.mts", "default": "./dist/observability.mjs" },
    "./filesystem": { "types": "./dist/filesystem.d.mts", "default": "./dist/filesystem.mjs" },
    "./mcp": { "types": "./dist/mcp.d.mts", "default": "./dist/mcp.mjs" },
    "./a2a": { "types": "./dist/a2a.d.mts", "default": "./dist/a2a.mjs" },
    "./env": { "types": "./dist/env.d.mts", "default": "./dist/env.mjs" },
    "./codex": { "types": "./dist/codex.d.mts", "default": "./dist/codex.mjs" },
    "./package.json": "./package.json"
  },
  "publishConfig": { "access": "public", "provenance": true },
  "scripts": {
    "build": "tsdown",
    "clean": "node -e \"for(const p of ['dist','artifacts'])require('node:fs').rmSync(p,{recursive:true,force:true})\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "pack": "pnpm pack --pack-destination artifacts",
    "test:pack": "node scripts/test-packed.mts",
    "check:publint": "publint",
    "check:types": "attw --profile esm-only --pack ."
  },
  "dependencies": {
    "@ai-agent-sdk/a2a": "workspace:^",
    "@ai-agent-sdk/agent": "workspace:^",
    "@ai-agent-sdk/auth-node": "workspace:^",
    "@ai-agent-sdk/core": "workspace:^",
    "@ai-agent-sdk/mcp": "workspace:^",
    "@ai-agent-sdk/mcp-node": "workspace:^",
    "@ai-agent-sdk/observability": "workspace:^",
    "@ai-agent-sdk/observability-fetch": "workspace:^",
    "@ai-agent-sdk/observability-node": "workspace:^",
    "@ai-agent-sdk/observability-otel": "workspace:^",
    "@ai-agent-sdk/provider-anthropic": "workspace:^",
    "@ai-agent-sdk/provider-codex": "workspace:^",
    "@ai-agent-sdk/provider-http": "workspace:^",
    "@ai-agent-sdk/provider-openai": "workspace:^",
    "@ai-agent-sdk/protocol-anthropic-messages": "workspace:^",
    "@ai-agent-sdk/protocol-responses": "workspace:^",
    "@ai-agent-sdk/skill-filesystem": "workspace:^"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@opentelemetry/api": "catalog:",
    "@opentelemetry/api-logs": "catalog:",
    "@types/node": "catalog:",
    "publint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": { "node": ">=22.12" },
  "aiAgentSdk": { "runtime": "node" }
}
