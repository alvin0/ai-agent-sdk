{
  "name": "@alvin0/ai-agent-sdk-skill-filesystem",
  "author": {
    "name": "alvin0 - chaulamdinhai",
    "email": "chaulamdinhai@gmail.com"
  },
  "version": "0.1.0",
  "description": "Node filesystem-backed skill provider for ai-agent-sdk",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alvin0/ai-agent-sdk.git",
    "directory": "packages/skill-filesystem"
  },
  "homepage": "https://github.com/alvin0/ai-agent-sdk/tree/main/packages/skill-filesystem#readme",
  "bugs": { "url": "https://github.com/alvin0/ai-agent-sdk/issues" },
  "type": "module",
  "sideEffects": false,
  "files": ["dist", "README.md", "LICENSE"],
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": { "types": "./dist/index.d.mts", "import": "./dist/index.mjs", "default": "./dist/index.mjs" },
    "./package.json": "./package.json"
  },
  "publishConfig": { "access": "public", "provenance": true },
  "scripts": {
    "build": "tsdown",
    "clean": "node -e \"for(const p of ['dist','artifacts'])require('node:fs').rmSync(p,{recursive:true,force:true})\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "pack": "pnpm pack --pack-destination artifacts",
    "test:pack": "node ../../scripts/test-packed-node-capability.mts skill-filesystem",
    "check:publint": "publint",
    "check:types": "attw --profile esm-only --pack ."
  },
  "peerDependencies": { "@alvin0/ai-agent-sdk-core": "workspace:^" },
  "dependencies": { "yaml": "catalog:" },
  "devDependencies": {
    "@alvin0/ai-agent-sdk-core": "workspace:^",
    "@arethetypeswrong/cli": "catalog:",
    "@types/node": "catalog:",
    "publint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": { "node": ">=22.12" },
  "aiAgentSdk": {
    "runtime": "node",
    "coreApi": 1,
    "roles": ["skill-provider"]
  }
}
