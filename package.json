{
  "name": "ai-agent-sdk",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "description": "Provider-neutral TypeScript SDK for building AI agents on the Anthropic Claude and OpenAI APIs",
  "keywords": [
    "ai",
    "agent",
    "llm",
    "anthropic",
    "claude",
    "openai",
    "sdk",
    "typescript"
  ],
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./anthropic": {
      "types": "./dist/anthropic.d.ts",
      "default": "./dist/anthropic.js"
    },
    "./openai": {
      "types": "./dist/openai.d.ts",
      "default": "./dist/openai.js"
    },
    "./codex": {
      "types": "./dist/codex.d.ts",
      "default": "./dist/codex.js"
    },
    "./a2a-client": {
      "types": "./dist/a2a-client.d.ts",
      "default": "./dist/a2a-client.js"
    },
    "./a2a-server": {
      "types": "./dist/a2a-server.d.ts",
      "default": "./dist/a2a-server.js"
    },
    "./skill-filesystem": {
      "types": "./dist/skill-filesystem.d.ts",
      "default": "./dist/skill-filesystem.js"
    },
    "./request-logger": {
      "types": "./dist/request-logger.d.ts",
      "default": "./dist/request-logger.js"
    },
    "./mcp-client": {
      "types": "./dist/mcp-client.d.ts",
      "default": "./dist/mcp-client.js"
    },
    "./mcp-server": {
      "types": "./dist/mcp-server.d.ts",
      "default": "./dist/mcp-server.js"
    },
    "./mcp-node": {
      "types": "./dist/mcp-node.d.ts",
      "default": "./dist/mcp-node.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm --filter @ai-agent-sdk/core build && pnpm --filter @ai-agent-sdk/agent build && pnpm --filter @ai-agent-sdk/provider-http build && pnpm --filter @ai-agent-sdk/protocol-anthropic-messages build && pnpm --filter @ai-agent-sdk/protocol-responses build && tsdown",
    "build:cli": "tsdown --config tsdown.cli.config.ts",
    "clean": "node -e \"for(const p of ['dist','dist-cli'])require('node:fs').rmSync(p,{recursive:true,force:true})\"",
    "typecheck": "pnpm --filter @ai-agent-sdk/core build && pnpm --filter @ai-agent-sdk/agent build && pnpm --filter @ai-agent-sdk/provider-http build && pnpm --filter @ai-agent-sdk/protocol-anthropic-messages build && pnpm --filter @ai-agent-sdk/protocol-responses build && tsc --noEmit",
    "pretest": "npm run build && npm run build:cli",
    "snapshot:public-api": "node scripts/snapshot-public-api.mts",
    "lint": "node scripts/check-package-graph.mts && node scripts/check-dependency-cruiser.mts && node scripts/check-agent-boundaries.mts && node scripts/check-runtime-boundaries.mts",
    "check:graph": "node scripts/check-package-graph.mts && node scripts/check-dependency-cruiser.mts && node scripts/check-agent-boundaries.mts",
    "check:agent-boundaries": "node scripts/check-agent-boundaries.mts",
    "check:core-graph": "node scripts/check-source-cycles.mts packages/core/src",
    "check:runtime-boundaries": "node scripts/check-runtime-boundaries.mts",
    "check:supply-chain": "node scripts/check-supply-chain.mts",
    "check:boundary-fixtures": "node scripts/check-negative-fixtures.mts",
    "workspace:build": "turbo run build",
    "workspace:typecheck": "turbo run typecheck",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "provider:codex:login-device": "npm run build:cli --silent && node dist-cli/provider-codex-login-device.mjs",
    "provider:codex:status": "npm run build:cli --silent && node dist-cli/provider-codex-login-device.mjs --status",
    "human": "npm run build:cli --silent && node dist-cli/human.mjs",
    "human:basic": "npm run build:cli --silent && node dist-cli/human.mjs --mode basic",
    "human:deep": "npm run build:cli --silent && node dist-cli/human.mjs --mode deep",
    "human:hil": "npm run build:cli --silent && node dist-cli/human.mjs --mode deep-human-in-loop",
    "human:web": "npm run build:cli --silent && node dist-cli/human.mjs --scenario web --force-tool",
    "human:vision": "npm run build:cli --silent && node dist-cli/human.mjs --scenario vision",
    "human:image-gen": "npm run build:cli --silent && node dist-cli/human.mjs --scenario image-gen --force-tool",
    "human:agentcode": "npm run build:cli --silent && node dist-cli/agentcode.mjs",
    "human:agentcode:multi-skill": "npm run build:cli --silent && node dist-cli/agentcode-multi-skill.mjs",
    "human:agentcode:multi-skill:verify": "npm run build:cli --silent && node dist-cli/agentcode-multi-skill-verify.mjs",
    "human:a2a-managed": "npm run build:cli --silent && node dist-cli/a2a-managed.mjs",
    "human:a2a-defined": "npm run build:cli --silent && node dist-cli/a2a-defined.mjs",
    "human:skill-stress": "npm run build:cli --silent && node dist-cli/skill-stress.mjs",
    "human:skill-stress:prepare": "npm run build:cli --silent && node dist-cli/skill-stress-prepare.mjs",
    "human:skill-showcase": "npm run build:cli --silent && node dist-cli/skill-showcase.mjs",
    "human:mcp": "npm run build:cli --silent && node dist-cli/mcp.mjs",
    "human:mcp:github": "npm run build:cli --silent && node dist-cli/mcp-github.mjs",
    "prepublishOnly": "npm test && npm run typecheck && npm run build"
  },
  "dependencies": {
    "@ai-agent-sdk/agent": "workspace:^",
    "@ai-agent-sdk/core": "workspace:^",
    "@ai-agent-sdk/provider-http": "workspace:^",
    "@ai-agent-sdk/protocol-anthropic-messages": "workspace:^",
    "@ai-agent-sdk/protocol-responses": "workspace:^",
    "@a2a-js/sdk": "catalog:"
  },
  "peerDependencies": {
    "@modelcontextprotocol/client": "catalog:",
    "@modelcontextprotocol/node": "catalog:",
    "@modelcontextprotocol/server": "catalog:"
  },
  "peerDependenciesMeta": {
    "@modelcontextprotocol/client": { "optional": true },
    "@modelcontextprotocol/node": { "optional": true },
    "@modelcontextprotocol/server": { "optional": true }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@changesets/cli": "catalog:",
    "@modelcontextprotocol/client": "catalog:",
    "@modelcontextprotocol/node": "catalog:",
    "@modelcontextprotocol/server": "catalog:",
    "@opentelemetry/api": "catalog:",
    "@opentelemetry/api-logs": "catalog:",
    "@types/node": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "dependency-cruiser": "catalog:",
    "playwright": "catalog:",
    "publint": "catalog:",
    "tsdown": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
