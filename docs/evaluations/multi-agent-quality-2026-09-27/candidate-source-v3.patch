+
+/** Wait for one stage; on cancellation, give it the teardown allowance to settle. */
+export async function settleWithin(
+  pending: Promise<ToolExecutionResult>,
+  signal: AbortSignal,
+  teardownTimeoutMs: number,
+  toolName: string,
+  stage: string,
+): Promise<ToolExecutionResult> {
