    payload: {
      title: 'Cache hit rate below target',
      severity: 'medium',
    },
  },
]

export function materializeSignals(events: readonly SignalEvent[]): Signal[] {
  const signals = new Map<string, Signal>()

  for (const event of events) {
    if (event.type === 'signal.created') {
      signals.set(event.signalId, {
        id: event.signalId,
        title: event.payload.title,
        severity: event.payload.severity,
        status: 'new',
        owner: null,
        createdAt: event.occurredAt,
        updatedAt: event.occurredAt,
      })
      continue
    }

    const current = signals.get(event.signalId)
    if (!current) continue

    if (event.type === 'signal.status-changed') {
      signals.set(event.signalId, {
        ...current,
        status: event.payload.status,
        updatedAt: event.occurredAt,
      })
      continue
    }

    signals.set(event.signalId, {
      ...current,
      owner: event.payload.owner,
      updatedAt: event.occurredAt,
    })
  }

  return [...signals.values()]
}
