export type SignalSeverity = 'critical' | 'high' | 'medium' | 'low'
export type SignalStatus = 'new' | 'investigating' | 'resolved'

export interface Signal {
  id: string
  title: string
  severity: SignalSeverity
  status: SignalStatus
  owner: string | null
  createdAt: string
  updatedAt: string
}

interface EventBase {
  id: string
  signalId: string
  occurredAt: string
}

export interface SignalCreatedEvent extends EventBase {
  type: 'signal.created'
  payload: {
    title: string
    severity: SignalSeverity
  }
}

export interface SignalStatusChangedEvent extends EventBase {
  type: 'signal.status-changed'
  payload: {
    status: SignalStatus
  }
}

export interface SignalOwnerChangedEvent extends EventBase {
  type: 'signal.owner-changed'
  payload: {
    owner: string | null
  }
}

export type SignalEvent =
  | SignalCreatedEvent
  | SignalStatusChangedEvent
  | SignalOwnerChangedEvent

export const demoEvents: SignalEvent[] = [
  {
    id: 'event-seed-1',
    type: 'signal.created',
    signalId: 'signal-database',
