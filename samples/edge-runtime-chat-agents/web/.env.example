# Optional. Without it the page asks the visitor for a key and keeps it in
# their browser. Set it when the deployment should pay for every run instead.
# OPENAI_API_KEY=sk-...

# Optional. Defaults are in src/server/config.ts.
# EDGE_CHAT_MODEL=gpt-5.4
# EDGE_CHAT_MODELS=gpt-5.4,gpt-5.4-mini,gpt-5.2,gpt-5.1,gpt-5,gpt-4.1,gpt-4o
# EDGE_CHAT_EFFORT=medium
# EDGE_CHAT_MODE=team
# Use team-auto to let the lead create specialist workers for each question.
# EDGE_CHAT_MODE=team-auto
# EDGE_CHAT_AUTO_MAX_WORKERS=3
# EDGE_CHAT_AUTO_WORKER_TIMEOUT_MS=90000
# OPENAI_BASE_URL=https://api.openai.com/v1
# EDGE_CHAT_INSTRUCTIONS=You are a helpful assistant.
# EDGE_CHAT_MAX_TURNS=12
# EDGE_CHAT_MAX_TOOL_CALLS=16
# EDGE_CHAT_MAX_TOTAL_TOKENS=200000
# EDGE_CHAT_MAX_SESSIONS=24
# EDGE_CHAT_SESSION_TTL_MS=1200000
