      "@ai-agent-sdk/protocol-responses": ["./packages/protocol-responses/index.d.ts"],
      "@ai-agent-sdk/protocol-anthropic-messages": ["./packages/protocol-anthropic-messages/index.d.ts"],
      "@ai-agent-sdk/mcp": ["./packages/mcp/index.d.ts"],
      "@ai-agent-sdk/mcp/client": ["./packages/mcp/client.d.ts"],
      "@ai-agent-sdk/mcp/server": ["./packages/mcp/server.d.ts"],
      "@ai-agent-sdk/mcp-server": ["./packages/mcp-server/index.d.ts"],
      "@ai-agent-sdk/mcp-node": ["./packages/mcp-node/index.d.ts"],
      "@ai-agent-sdk/mcp-node-server": ["./packages/mcp-node-server/index.d.ts"],
      "@ai-agent-sdk/skill-filesystem": ["./packages/skill-filesystem/index.d.ts"],
      "@ai-agent-sdk/observability-fetch": ["./packages/observability-fetch/index.d.ts"],
      "@ai-agent-sdk/observability-browser": ["./packages/observability-browser/index.d.ts"],
