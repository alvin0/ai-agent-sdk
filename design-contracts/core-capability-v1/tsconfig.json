      "@ai-agent-sdk/observability-otel": ["./packages/observability-otel/index.d.ts"],
      "@ai-agent-sdk/auth-node": ["./packages/auth-node/index.d.ts"],
      "@ai-agent-sdk/auth-node/env": ["./packages/auth-node/env.d.ts"],
      "@ai-agent-sdk/auth-node/codex": ["./packages/auth-node/codex.d.ts"],
      "@ai-agent-sdk/a2a": ["./packages/a2a/index.d.ts"],
      "@ai-agent-sdk/a2a/client": ["./packages/a2a/client.d.ts"],
      "@ai-agent-sdk/a2a/server": ["./packages/a2a/server.d.ts"],
      "@current/observability": ["./packages/core/observability.d.ts"],
