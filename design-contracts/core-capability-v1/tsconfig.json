      "@ai-agent-sdk/core/skills": ["./packages/core/skills.d.ts"],
      "@ai-agent-sdk/core/tools": ["./packages/core/tools.d.ts"],
      "@ai-agent-sdk/provider-openai": ["./packages/provider-openai/index.d.ts"],
      "@ai-agent-sdk/provider-anthropic": ["./packages/provider-anthropic/index.d.ts"],
      "@ai-agent-sdk/provider-codex": ["./packages/provider-codex/index.d.ts"],
