      "@compat/a2a-root": ["./packages/a2a/index.d.ts"],
      "@compat/a2a-client": ["./packages/a2a/client.d.ts"],
      "@compat/a2a-server": ["./packages/a2a/server.d.ts"],
      "@compat/skill-filesystem": ["./packages/skill-filesystem/index.d.ts"],
      "@compat/skill-validation": ["./packages/core/skills.d.ts"],
      "@compat/provider-http": ["./packages/provider-http/index.d.ts"],
      "@compat/provider-openai": ["./packages/provider-openai/index.d.ts"],
      "@compat/provider-anthropic": ["./packages/provider-anthropic/index.d.ts"],
      "@compat/provider-codex-signatures": ["./packages/provider-codex/index.d.ts"],
      "@compat/mcp-client": ["./packages/mcp/client.d.ts"],
